{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "dev-data.ts", "vite.config.ts", "../src/report-data.ts"]
}
